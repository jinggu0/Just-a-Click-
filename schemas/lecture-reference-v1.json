{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lecture-reference-v1",
  "description": "Reviewed answer key for one evaluation lecture. Kept under artifacts/eval-lectures/, never committed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lecture_id",
    "course",
    "date",
    "permission",
    "review",
    "transcript_run",
    "facts",
    "notices",
    "code",
    "terms"
  ],
  "properties": {
    "schema_version": {
      "const": "lecture-reference-v1"
    },
    "lecture_id": {
      "type": "string",
      "minLength": 1
    },
    "course": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "granted_by",
        "scope",
        "confirmed_on"
      ],
      "properties": {
        "granted_by": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "confirmed_on": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "reviewed"
          ]
        },
        "reviewer": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "transcript_run": {
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/notice"
      }
    },
    "code": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/code"
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/term"
      }
    }
  },
  "$defs": {
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^s[0-9]+$"
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "segments",
        "importance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "segments": {
          "$ref": "#/$defs/segments"
        },
        "importance": {
          "enum": [
            "key",
            "normal"
          ]
        }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "content",
        "date_text",
        "scope_text",
        "status",
        "segments"
      ],
      "properties": {
        "kind": {
          "enum": [
            "exam",
            "assignment",
            "announcement"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "date_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "scheduled",
            "cancelled"
          ]
        },
        "segments": {
          "$ref": "#/$defs/segments"
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "segments"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "segments": {
          "$ref": "#/$defs/segments"
        }
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heard",
        "correct",
        "segments"
      ],
      "properties": {
        "heard": {
          "type": "string"
        },
        "correct": {
          "type": "string",
          "minLength": 1
        },
        "segments": {
          "$ref": "#/$defs/segments"
        }
      }
    }
  }
}
